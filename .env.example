# =============================================================================
# AI Initializer - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# =============================================================================
# POSTGRES DATABASE
# =============================================================================

# PostgreSQL connection port (default: 5432)
POSTGRES_PORT=5432

# PostgreSQL username (default: postgres)
POSTGRES_USER=postgres

# PostgreSQL password - CHANGE THIS IN PRODUCTION
POSTGRES_PASSWORD=postgres

# PostgreSQL database name (default: ai_initializer)
POSTGRES_DB=ai_initializer

# =============================================================================
# REDIS CACHE
# =============================================================================

# Redis connection port (default: 6379)
REDIS_PORT=6379

# Redis password - CHANGE THIS IN PRODUCTION
REDIS_PASSWORD=redis

# =============================================================================
# BACKEND SERVICE
# =============================================================================

# Backend service port (default: 3001)
BACKEND_PORT=3001

# Node environment (development | production | test)
NODE_ENV=development

# Full PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_initializer

# Full Redis connection URL
# Format: redis://:password@host:port
REDIS_URL=redis://:redis@redis:6379

# JWT secret for authentication tokens - CHANGE THIS IN PRODUCTION
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-change-in-production

# CORS origin for frontend requests
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# FRONTEND SERVICE
# =============================================================================

# Frontend service port (default: 3000)
FRONTEND_PORT=3000

# Backend API URL for client-side requests
NEXT_PUBLIC_API_URL=http://localhost:3001

# =============================================================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# =============================================================================

# Logging level (debug | info | warn | error)
LOG_LEVEL=debug

# Session secret for express-session - CHANGE THIS IN PRODUCTION
SESSION_SECRET=your-session-secret-here-change-in-production

# SMTP configuration for emails (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM=noreply@example.com

# AWS S3 configuration for file uploads (optional)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name

# Rate limiting (requests per window)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# Active AI Provider to use (openai | anthropic | deepgram | elevenlabs | azure-openai | google | mistral | groq | ollama | custom)
# Simply change this value to switch providers - ZERO CODE CHANGES required!
ACTIVE_AI_PROVIDER=openai

# API key for the selected AI provider
AI_API_KEY=your-api-key-here

# Custom base URL (optional, useful for proxies or self-hosted endpoints)
# AI_BASE_URL=https://api.openai.com/v1

# Organization ID (optional, for providers that support it)
# AI_ORGANIZATION=your-org-id

# Default model to use (optional, provider-specific)
# AI_DEFAULT_MODEL=gpt-4

# Request timeout in milliseconds (default: 30000)
# AI_TIMEOUT=30000

# Maximum number of retries for failed requests (default: 3)
# AI_MAX_RETRIES=3

# =============================================================================
# PROVIDER-SPECIFIC CONFIGURATION
# =============================================================================

# ElevenLabs: Default voice ID (optional)
# AI_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# =============================================================================
# TENANT AI CONFIGURATION
# =============================================================================

# Encryption key for tenant-specific API keys (AES-256)
# Generate a strong key: openssl rand -hex 32
# Required if using per-tenant AI provider configurations
TENANT_AI_ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# =============================================================================
# WEBHOOK SECRETS
# =============================================================================
# Each provider's shared secret for HMAC signature verification.
# Leave a variable unset (or empty) to skip signature verification for that
# provider — convenient for local development, but NEVER do this in production.

# GitHub webhook secret (configured in GitHub → repo → Settings → Webhooks)
# Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# Stripe webhook signing secret (from Stripe Dashboard → Developers → Webhooks)
# Looks like: whsec_...
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# GitLab webhook secret token (configured in GitLab → project → Settings → Webhooks)
GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret-here

# Generic HMAC-SHA256 webhook secret (for internal / custom senders)
GENERIC_WEBHOOK_SECRET=your-generic-webhook-secret-here

# =============================================================================
# RATE LIMITING
# =============================================================================
# Redis-backed, fixed-window rate limits.  All values are optional; defaults
# are shown.  Remove or comment out a variable to use the default.

# Length of the rate-limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per authenticated user per window (default: 100)
RATE_LIMIT_USER_MAX=100

# Maximum requests per tenant per window (default: 1000)
RATE_LIMIT_TENANT_MAX=1000

# Maximum requests per IP address per window — applies to unauthenticated
# traffic and as a backstop for all requests (default: 50)
RATE_LIMIT_IP_MAX=50

# Set to "true" to skip counting requests that result in a non-2xx response
# Useful for auth endpoints where failed login attempts should not burn quota
# (default: false)
RATE_LIMIT_SKIP_FAILED=false
