# Copy this file to .env and fill in secrets for your local environment.
# This file mirrors the backend schema in packages/backend/src/audit/env.ts.

# Node runtime environment (development | test | production)
NODE_ENV=development

# Backend HTTP port
PORT=3001

# Backend bind host
HOST=0.0.0.0

# PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aidb

# Redis connection URL
REDIS_URL=redis://:redis@localhost:6379

JWT_PRIVATE_KEY= # paste contents of keys/private.pem here (or leave blank to use disk)
JWT_PUBLIC_KEY= # paste contents of keys/public.pem here

# Access token expiry
JWT_EXPIRY=15m

# Refresh token expiry
JWT_REFRESH_EXPIRY=7d

TENANT_CONFIG_ENCRYPTION_KEY= # exactly 32 chars

# Max requests per authenticated user per window
RATE_LIMIT_USER_MAX=100

# Max requests per tenant per window
RATE_LIMIT_TENANT_MAX=1000

# Max requests per IP per window
RATE_LIMIT_IP_MAX=50

# Rate limit window in milliseconds
RATE_LIMIT_WINDOW_MS=900000

# Enable or disable audit logging (true | false)
ENABLE_AUDIT_LOGGING=true

# Audit log retention in days
AUDIT_LOG_RETENTION_DAYS=90

# Allowed CORS origin
CORS_ORIGIN=http://localhost:3000

# Allow credentials in CORS requests (true | false)
CORS_CREDENTIALS=true

# Maximum upload size in bytes
MAX_FILE_SIZE=10485760

# Default AI provider name
ACTIVE_AI_PROVIDER=openai

# API key for default AI provider (can be empty if using tenant-level keys)
AI_API_KEY=

# Optional custom AI provider base URL
AI_BASE_URL=

# Optional: GitHub webhook secret
GITHUB_WEBHOOK_SECRET=

# Optional: Stripe webhook secret
STRIPE_WEBHOOK_SECRET=

# Optional: GitLab webhook secret
GITLAB_WEBHOOK_SECRET=

# Optional: Generic webhook secret
GENERIC_WEBHOOK_SECRET=

# Optional: default tenant UUID used by some routes/services
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
