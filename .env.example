# Copy this file to .env and fill in secrets for your local environment.
# This file mirrors the backend schema in packages/backend/src/audit/env.ts.
# Every variable below is documented with a one-line comment explaining its purpose.

# Node runtime environment (development | test | production)
NODE_ENV=development

# Backend HTTP server port
PORT=3001

# Backend server bind host address
HOST=0.0.0.0

# PostgreSQL connection URL (postgresql://user:password@host:port/database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aidb

# Redis connection URL (redis://:password@host:port)
REDIS_URL=redis://:redis@localhost:6379

# JWT private key for signing tokens (paste contents of keys/private.pem or leave blank to use disk)
JWT_PRIVATE_KEY=

# JWT public key for verifying tokens (paste contents of keys/public.pem or leave blank to use disk)
JWT_PUBLIC_KEY=

# JWT access token expiry duration (e.g., 15m, 1h, 7d)
JWT_EXPIRY=15m

# JWT refresh token expiry duration (e.g., 15m, 1h, 7d)
JWT_REFRESH_EXPIRY=7d

# Tenant configuration encryption key (must be exactly 32 characters)
TENANT_CONFIG_ENCRYPTION_KEY=

# Maximum requests per authenticated user within the rate limit window
RATE_LIMIT_USER_MAX=100

# Maximum requests per tenant within the rate limit window
RATE_LIMIT_TENANT_MAX=1000

# Maximum requests per IP address within the rate limit window
RATE_LIMIT_IP_MAX=50

# Rate limit window duration in milliseconds
RATE_LIMIT_WINDOW_MS=900000

# Enable or disable audit logging (true or false)
ENABLE_AUDIT_LOGGING=true

# How long to retain audit logs in days
AUDIT_LOG_RETENTION_DAYS=90

# CORS allowed origin for frontend requests
CORS_ORIGIN=http://localhost:3000

# Allow credentials in CORS requests (true or false)
CORS_CREDENTIALS=true

# Maximum file upload size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# Default AI provider name (e.g., openai, anthropic, etc.)
ACTIVE_AI_PROVIDER=openai

# API key for the default AI provider (optional, can be set per-tenant)
AI_API_KEY=

# Custom base URL for AI provider (optional, useful for proxies or self-hosted models)
AI_BASE_URL=

# GitHub webhook secret for validating GitHub webhook requests (optional)
GITHUB_WEBHOOK_SECRET=

# Stripe webhook secret for validating Stripe webhook requests (optional)
STRIPE_WEBHOOK_SECRET=

# GitLab webhook secret for validating GitLab webhook requests (optional)
GITLAB_WEBHOOK_SECRET=

# Generic webhook secret for validating generic webhook requests (optional)
GENERIC_WEBHOOK_SECRET=

# Default tenant UUID used by some routes/services (optional)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
