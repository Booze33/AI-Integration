# =============================================================================
# AI Integration Platform - Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local to version control

# =============================================================================
# BACKEND API
# =============================================================================

# Backend API URL - REQUIRED for production
# For local development: http://localhost:3001
# For Vercel deployment: Set this to your backend deployment URL
NEXT_PUBLIC_BACKEND_URL=https://your-backend-api.vercel.app

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================

# Enable mock mode when backend is not available (optional)
# When set to 'true', API calls will return mock data instead of failing
# Useful for build previews or when backend is temporarily unavailable
NEXT_PUBLIC_MOCK_MODE=false

# =============================================================================
# ANALYTICS & MONITORING (Optional)
# =============================================================================

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# Enable error reporting in production
NEXT_PUBLIC_ERROR_REPORTING=true