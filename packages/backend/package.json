{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node src/database/seeds/run-seed.ts",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up --dir dist/database/migrations",
    "migrate:down": "node-pg-migrate down --dir dist/database/migrations",
    "migrate:create": "node-pg-migrate create --dir src/database/migrations",
    "migrate:status": "node-pg-migrate status --dir src/database/migrations",
    "generate-keys": "ts-node src/scripts/generate-keypair.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-integration/types": "workspace:*",
    "@types/multer": "^2.1.0",
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.73.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^4.22.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "node-pg-migrate": "^8.0.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  }
}
