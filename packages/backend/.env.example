# =============================================================================
# Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Variables marked REQUIRED must be set before the server will start.
# Variables marked OPTIONAL have sensible defaults and can be omitted.
# All validation is enforced at startup via Zod (see src/audit/env.ts).
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Runtime environment. Controls logging verbosity, error detail in responses,
# and certain security checks (e.g. cookie secure flag, HTTPS enforcement).
# Accepted values: development | test | production
# Default: development
NODE_ENV=development

# TCP port the HTTP server listens on.
# Default: 3001
PORT=3001

# Network interface to bind. Use 0.0.0.0 to accept connections on all
# interfaces (required inside Docker / Kubernetes).
# Default: 0.0.0.0
HOST=0.0.0.0

# Milliseconds to wait for in-flight requests to finish during graceful
# shutdown before forcing the process to exit.
# Default: 15000  (15 s)
# SHUTDOWN_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# REQUIRED — must be a valid postgresql:// connection URL.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_initializer

# Connection pool tuning (all OPTIONAL — defaults shown).
# Increase pool sizes under heavy load; reduce to conserve DB connections.
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30000        # ms before an idle connection is released
# DB_POOL_CONNECTION_TIMEOUT=5000   # ms to wait when acquiring a connection
# DB_POOL_ALLOW_EXIT_ON_IDLE=false  # set true in short-lived scripts/migrations

# Statement / query timeouts (ms). Prevents runaway queries from blocking the pool.
# DB_STATEMENT_TIMEOUT=30000
# DB_QUERY_TIMEOUT=30000

# Enable SSL for the database connection. When true, rejectUnauthorized is set
# to false (useful for managed cloud DBs with self-signed certs).
# DB_SSL=false

# Enable verbose query logging in development.
# DEBUG=false


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REQUIRED — used for caching, rate-limit counters, and the webhook job queue.
# Provide either REDIS_URL (takes precedence) or the individual host/port/password.

REDIS_URL=redis://:redis@localhost:6379

# Individual connection parameters (used when REDIS_URL is not set).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis


# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# RS256 key pair used to sign and verify access tokens.
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the PEM content as a single line with literal \n for newlines,
# or encode it in Base64 and decode it inside jwt.ts.
#
# OPTIONAL in development (falls back to an auto-generated ephemeral key pair);
# REQUIRED in production — the server will refuse to start without them.

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Duration strings accepted by the `ms` / `jsonwebtoken` libraries.
# Access token lifetime (short-lived for security).
# Default: 15m
JWT_EXPIRY=15m

# Refresh token lifetime (long-lived, stored server-side in Redis).
# Default: 7d
JWT_REFRESH_EXPIRY=7d

# Default tenant UUID assigned to tokens when no tenant is resolved from the
# request. Override to match the seed tenant in your database.
# Default: 00000000-0000-0000-0000-000000000000
# DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000


# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# REQUIRED — AES-256 key used to encrypt per-tenant AI provider credentials
# stored in the database. Must be exactly 32 ASCII characters.
# Generate with: openssl rand -hex 16   (produces 32 hex chars)

TENANT_CONFIG_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Sliding-window counters stored in Redis. Requests exceeding the limit receive
# HTTP 429. All values are OPTIONAL — defaults shown.

# Maximum requests per authenticated user within the window.
# Default: 100
RATE_LIMIT_USER_MAX=100

# Maximum requests per tenant within the window.
# Default: 1000
RATE_LIMIT_TENANT_MAX=1000

# Maximum requests per IP address within the window (unauthenticated traffic).
# Default: 50
RATE_LIMIT_IP_MAX=50

# Rolling window length in milliseconds.
# Default: 900000  (15 minutes)
RATE_LIMIT_WINDOW_MS=900000


# -----------------------------------------------------------------------------
# Audit Logging
# -----------------------------------------------------------------------------
# When enabled, every mutating API call is written to the audit_logs table.

# Enable or disable audit logging entirely.
# Default: true
ENABLE_AUDIT_LOGGING=true

# Number of days to retain audit log entries before automatic pruning.
# Default: 90
AUDIT_LOG_RETENTION_DAYS=90


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Controls which origins browsers are allowed to send cross-origin requests from.

# Allowed origin(s). For multiple origins, use a comma-separated list or a
# regex string, depending on your CORS middleware configuration.
# Default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Whether to allow cookies / Authorization headers in cross-origin requests.
# Must be true when the frontend sends credentials (JWT cookies).
# Default: true
CORS_CREDENTIALS=true


# -----------------------------------------------------------------------------
# File Uploads
# -----------------------------------------------------------------------------

# Maximum size (in bytes) of a single uploaded file.
# Default: 10485760  (10 MB)
MAX_FILE_SIZE=10485760


# -----------------------------------------------------------------------------
# AI Provider
# -----------------------------------------------------------------------------
# Global / fallback AI provider settings. These are used when no tenant-level
# override is configured. Per-tenant credentials are stored encrypted in the DB.

# Which provider adapter to activate.
# Accepted values: openai | anthropic | (any registered provider key)
# Default: openai
ACTIVE_AI_PROVIDER=openai

# API key for the active provider.
# OPTIONAL here — tenants can supply their own keys via the provider config API.
AI_API_KEY=

# Base URL for the provider's API. Override to point at a local proxy, Azure
# OpenAI endpoint, or an OpenAI-compatible self-hosted model.
# Default (openai): https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1


# -----------------------------------------------------------------------------
# Observability (OPTIONAL)
# -----------------------------------------------------------------------------

# Cap the Node.js heap. When set, the security audit checks warn if heap usage
# exceeds this threshold.
# MEMORY_LIMIT_MB=512
